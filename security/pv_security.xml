<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Module Category                                               -->
    <!-- ============================================================ -->
    <record id="res_groups_privilege_posventa" model="res.groups.privilege">
        <field name="name">Posventa</field>
        <field name="description">Gestión integral de posventa Crucianelli</field>
        <field name="sequence">100</field>
    </record>

    <!-- ============================================================ -->
    <!-- Groups                                                        -->
    <!-- ============================================================ -->
    <record id="group_pv_concesionario" model="res.groups">
        <field name="name">Concesionario</field>
        <field name="privilege_id" ref="res_groups_privilege_posventa"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">
            Acceso de concesionario: puede crear máquinas, certificados y tickets propios.
            Solo ve datos de su concesionario.
        </field>
    </record>

    <record id="group_pv_staff" model="res.groups">
        <field name="name">Staff Call Center</field>
        <field name="privilege_id" ref="res_groups_privilege_posventa"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">
            Gestión integral de tickets, seguimiento operativo, cambio de estados,
            carga de datos SAP, visualización de dashboards.
        </field>
    </record>

    <record id="group_pv_admin" model="res.groups">
        <field name="name">Administrador Posventa</field>
        <field name="privilege_id" ref="res_groups_privilege_posventa"/>
        <field name="implied_ids" eval="[(5, 0, 0), (4, ref('group_pv_staff')), (4, ref('group_pv_concesionario'))]"/>        <field name="comment">
            Acceso total: gestión de usuarios, concesionarios, reasignación de tickets,
            configuración general, importación masiva.
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules                                                  -->
    <!-- ============================================================ -->

    <!--
        Pertenencia a un concesionario: el usuario es su usuario principal, o su partner
        es el partner del concesionario o un contacto de esa empresa (commercial_partner_id).
        Debe coincidir con pv.concesionario._get_concesionario_for_user().
    -->

    <record id="rule_pv_maquina_concesionario" model="ir.rule">
        <field name="name">Máquinas: propias o con transferencia pendiente hacia el concesionario</field>
        <field name="model_id" ref="model_pv_maquina"/>
        <field name="domain_force">['|', '|', ('concesionario_id.user_id', '=', user.id), ('concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id]), '&amp;', ('estado', '=', 'pendiente'), '|', ('concesionario_destino_id.user_id', '=', user.id), ('concesionario_destino_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_maquina_staff" model="ir.rule">
        <field name="name">Máquinas: todas (Staff)</field>
        <field name="model_id" ref="model_pv_maquina"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_concesionario" model="ir.rule">
        <field name="name">Tickets: solo propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_ticket"/>
        <field name="domain_force">['|', ('concesionario_id.user_id', '=', user.id), ('concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_ticket_staff" model="ir.rule">
        <field name="name">Tickets: todos no borradores (Staff)</field>
        <field name="model_id" ref="model_pv_ticket"/>
        <field name="domain_force">[('estado', '!=', 'borrador')]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_admin" model="ir.rule">
        <field name="name">Tickets: todos sin restricción (Admin)</field>
        <field name="model_id" ref="model_pv_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_admin'))]"/>
    </record>

    <record id="rule_pv_certificado_concesionario" model="ir.rule">
        <field name="name">Certificados: emitidos por el concesionario o de sus máquinas actuales</field>
        <field name="model_id" ref="model_pv_certificado"/>
        <field name="domain_force">['|', '|', ('concesionario_id.user_id', '=', user.id), ('concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id]), '|', ('maquina_id.concesionario_id.user_id', '=', user.id), ('maquina_id.concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_certificado_staff" model="ir.rule">
        <field name="name">Certificados: todos (Staff)</field>
        <field name="model_id" ref="model_pv_certificado"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_concesionario_concesionario" model="ir.rule">
        <field name="name">Concesionarios: lectura global (Concesionario)</field>
        <field name="model_id" ref="model_pv_concesionario"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_pv_concesionario_staff" model="ir.rule">
        <field name="name">Concesionarios: todos (Staff)</field>
        <field name="model_id" ref="model_pv_concesionario"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_concesionario_contacto_concesionario" model="ir.rule">
        <field name="name">Personal histórico: solo del propio concesionario</field>
        <field name="model_id" ref="model_pv_concesionario_contacto"/>
        <field name="domain_force">['|', ('concesionario_id.user_id', '=', user.id), ('concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_concesionario_contacto_staff" model="ir.rule">
        <field name="name">Personal histórico: todos (Staff)</field>
        <field name="model_id" ref="model_pv_concesionario_contacto"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_multimedia_concesionario" model="ir.rule">
        <field name="name">Multimedia: solo de tickets propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_ticket_multimedia"/>
        <field name="domain_force">['|', ('ticket_id.concesionario_id.user_id', '=', user.id), ('ticket_id.concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_ticket_multimedia_staff" model="ir.rule">
        <field name="name">Multimedia: todos (Staff)</field>
        <field name="model_id" ref="model_pv_ticket_multimedia"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_medida_concesionario" model="ir.rule">
        <field name="name">Medidas: solo de tickets propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_ticket_medida"/>
        <field name="domain_force">['|', ('ticket_id.concesionario_id.user_id', '=', user.id), ('ticket_id.concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_ticket_medida_staff" model="ir.rule">
        <field name="name">Medidas: todos (Staff)</field>
        <field name="model_id" ref="model_pv_ticket_medida"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_campo_valor_concesionario" model="ir.rule">
        <field name="name">Campos adicionales: solo de tickets propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_ticket_campo_valor"/>
        <field name="domain_force">['|', ('ticket_id.concesionario_id.user_id', '=', user.id), ('ticket_id.concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_ticket_campo_valor_staff" model="ir.rule">
        <field name="name">Campos adicionales: todos (Staff)</field>
        <field name="model_id" ref="model_pv_ticket_campo_valor"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

</odoo>
