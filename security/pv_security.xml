<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_posventa" model="res.groups.privilege">
        <field name="name">Posventa</field>
        <field name="description">Gestión integral de posventa Crucianelli</field>
        <field name="sequence">100</field>
    </record>

    <!-- Concesionario: usuarios portal de la red, operan desde /my/posventa -->
    <record id="group_pv_concesionario" model="res.groups">
        <field name="name">Concesionario</field>
        <field name="privilege_id" ref="res_groups_privilege_posventa"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Usuario portal de un concesionario: ve y opera solo las máquinas, certificados y reclamos de su empresa.</field>
    </record>

    <record id="group_pv_staff" model="res.groups">
        <field name="name">Staff Call Center</field>
        <field name="privilege_id" ref="res_groups_privilege_posventa"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Gestión de reclamos enviados: toma, medidas, aceptación/rechazo, cierre y datos SAP.</field>
    </record>

    <record id="group_pv_admin" model="res.groups">
        <field name="name">Administrador Posventa</field>
        <field name="privilege_id" ref="res_groups_privilege_posventa"/>
        <field name="implied_ids" eval="[(5, 0, 0), (4, ref('group_pv_staff')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">Acceso total: concesionarios y su acceso al portal, máquinas, liberaciones, configuración e importación.</field>
    </record>

    <!--
        Pertenencia a un concesionario: el partner del usuario es la empresa del concesionario
        o un contacto de ella. Debe coincidir con pv.concesionario._get_by_contact().
    -->

    <record id="rule_pv_maquina_concesionario" model="ir.rule">
        <field name="name">Máquinas: propias o con traslado pendiente hacia el concesionario</field>
        <field name="model_id" ref="model_pv_maquina"/>
        <field name="domain_force">['|', ('concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id]), '&amp;', ('estado', '=', 'pendiente'), ('concesionario_destino_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_maquina_staff" model="ir.rule">
        <field name="name">Máquinas: todas (Staff)</field>
        <field name="model_id" ref="model_pv_maquina"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_concesionario" model="ir.rule">
        <field name="name">Tickets: solo propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_ticket"/>
        <field name="domain_force">[('concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_ticket_staff" model="ir.rule">
        <field name="name">Tickets: todos no borradores (Staff)</field>
        <field name="model_id" ref="model_pv_ticket"/>
        <field name="domain_force">[('estado', '!=', 'borrador')]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_admin" model="ir.rule">
        <field name="name">Tickets: todos sin restricción (Admin)</field>
        <field name="model_id" ref="model_pv_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_admin'))]"/>
    </record>

    <record id="rule_pv_certificado_concesionario" model="ir.rule">
        <field name="name">Certificados: emitidos por el concesionario o de sus máquinas actuales</field>
        <field name="model_id" ref="model_pv_certificado"/>
        <field name="domain_force">['|', ('concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id]), ('maquina_id.concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_certificado_staff" model="ir.rule">
        <field name="name">Certificados: todos (Staff)</field>
        <field name="model_id" ref="model_pv_certificado"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_multimedia_concesionario" model="ir.rule">
        <field name="name">Multimedia: solo de tickets propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_ticket_multimedia"/>
        <field name="domain_force">[('ticket_id.concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_ticket_multimedia_staff" model="ir.rule">
        <field name="name">Multimedia: todos (Staff)</field>
        <field name="model_id" ref="model_pv_ticket_multimedia"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_medida_concesionario" model="ir.rule">
        <field name="name">Medidas: solo de tickets propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_ticket_medida"/>
        <field name="domain_force">[('ticket_id.concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_ticket_medida_staff" model="ir.rule">
        <field name="name">Medidas: todos (Staff)</field>
        <field name="model_id" ref="model_pv_ticket_medida"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_ticket_campo_valor_concesionario" model="ir.rule">
        <field name="name">Campos adicionales: solo de tickets propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_ticket_campo_valor"/>
        <field name="domain_force">[('ticket_id.concesionario_id.partner_id', 'in', [user.partner_id.id, user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <record id="rule_pv_ticket_campo_valor_staff" model="ir.rule">
        <field name="name">Campos adicionales: todos (Staff)</field>
        <field name="model_id" ref="model_pv_ticket_campo_valor"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>
</odoo>
