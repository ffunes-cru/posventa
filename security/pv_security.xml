<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Module Category                                               -->
    <!-- ============================================================ -->
    <record id="res_groups_privilege_posventa" model="res.groups.privilege">
        <field name="name">Posventa</field>
        <field name="description">Gestión integral de posventa Crucianelli</field>
        <field name="sequence">100</field>
    </record>

    <!-- ============================================================ -->
    <!-- Groups                                                        -->
    <!-- ============================================================ -->
    <record id="group_pv_concesionario" model="res.groups">
        <field name="name">Concesionario</field>
        <field name="privilege_id" ref="res_groups_privilege_posventa"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">
            Acceso de concesionario: puede crear máquinas, certificados y tickets propios.
            Solo ve datos de su concesionario.
        </field>
    </record>

    <record id="group_pv_staff" model="res.groups">
        <field name="name">Staff Call Center</field>
        <field name="privilege_id" ref="res_groups_privilege_posventa"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">
            Gestión integral de tickets, seguimiento operativo, cambio de estados,
            carga de datos SAP, visualización de dashboards.
        </field>
    </record>

    <record id="group_pv_admin" model="res.groups">
        <field name="name">Administrador Posventa</field>
        <field name="privilege_id" ref="res_groups_privilege_posventa"/>
        <field name="implied_ids" eval="[(5, 0, 0), (4, ref('group_pv_staff')), (4, ref('group_pv_concesionario'))]"/>        <field name="comment">
            Acceso total: gestión de usuarios, concesionarios, reasignación de tickets,
            configuración general, importación masiva.
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules                                                  -->
    <!-- ============================================================ -->

    <!-- Concesionario: solo ve sus propias máquinas -->
    <record id="rule_pv_maquina_concesionario" model="ir.rule">
        <field name="name">Máquinas: solo propias (Concesionario)</field>
        <field name="model_id" ref="model_pv_maquina"/>
        <field name="domain_force">[('concesionario_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <!-- Staff/Admin: ve todas las máquinas -->
    <record id="rule_pv_maquina_staff" model="ir.rule">
        <field name="name">Máquinas: todas (Staff)</field>
        <field name="model_id" ref="model_pv_maquina"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <!-- Concesionario: solo ve sus propios tickets -->
    <record id="rule_pv_ticket_concesionario" model="ir.rule">
        <field name="name">Tickets: solo propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_ticket"/>
        <field name="domain_force">[('concesionario_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <!-- Staff/Admin: ve todos los tickets -->
    <record id="rule_pv_ticket_staff" model="ir.rule">
        <field name="name">Tickets: todos (Staff)</field>
        <field name="model_id" ref="model_pv_ticket"/>
        <field name="domain_force">[('estado', '!=', 'borrador')]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <!-- Concesionario: solo ve sus propios certificados -->
    <record id="rule_pv_certificado_concesionario" model="ir.rule">
        <field name="name">Certificados: solo propios (Concesionario)</field>
        <field name="model_id" ref="model_pv_certificado"/>
        <field name="domain_force">[('concesionario_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
    </record>

    <!-- Staff/Admin: ve todos los certificados -->
    <record id="rule_pv_certificado_staff" model="ir.rule">
        <field name="name">Certificados: todos (Staff)</field>
        <field name="model_id" ref="model_pv_certificado"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>

    <record id="rule_pv_concesionario_concesionario" model="ir.rule">
        <field name="name">Concesionarios: lectura global, escritura propia</field>
        <field name="model_id" ref="model_pv_concesionario"/>
        <field name="domain_force">[(1, '=', 1)]</field> <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_pv_concesionario_propio_write" model="ir.rule">
        <field name="name">Concesionarios: modificación propia</field>
        <field name="model_id" ref="model_pv_concesionario"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pv_concesionario'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Staff/Admin: ve todos los concesionarios -->
    <record id="rule_pv_concesionario_staff" model="ir.rule">
        <field name="name">Concesionarios: todos (Staff)</field>
        <field name="model_id" ref="model_pv_concesionario"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_pv_staff'))]"/>
    </record>
</odoo>
