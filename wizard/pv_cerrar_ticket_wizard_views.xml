<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pv_cerrar_ticket_wizard_view_form" model="ir.ui.view">
        <field name="name">pv.cerrar.ticket.wizard.view.form</field>
        <field name="model">pv.cerrar.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Cerrar Ticket / Garantía y Devolución">
                <sheet>
                    <div class="alert alert-info border-start border-4 border-info shadow-sm rounded-3 mb-3 p-3" role="status">
                        <i class="fa fa-info-circle me-1"/>
                        Indique la solución aplicada y si la garantía cubre la pieza. Si no la cubre, la pieza la abona el concesionario/cliente y debe indicar los motivos.
                    </div>
                    <group>
                        <field name="ticket_id" readonly="1" options="{'no_open': True}"/>
                        <field name="tipo_garantia" widget="radio" options="{'horizontal': true}"/>
                        <field name="garantia_aceptada" widget="boolean_toggle" string="¿La garantía cubre la pieza?"/>
                        <field name="garantia_rechazo_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}" invisible="garantia_aceptada" required="not garantia_aceptada" placeholder="Seleccione motivos sin cobertura..."/>
                        <field name="solucion_aplicada" placeholder="Describa qué se hizo para resolver la falla (repuesto enviado, ajuste, reparación en campo...)" style="min-height: 80px;"/>
                        <field name="sap_numero_orden" placeholder="Ej: 4500012345 (opcional)"/>
                        <field name="garantia_observaciones" placeholder="Ingrese observaciones y justificación del análisis de la garantía y devolución..." style="min-height: 80px;"/>
                        <field name="garantia_adjunto" filename="garantia_adjunto_name"/>
                        <field name="garantia_adjunto_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirmar" string="Confirmar Cierre de Ticket" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
