<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rechazo de reclamo: el concesionario cargó algo mal y debe crear un ticket nuevo -->
        <record id="rechazo_reclamo_info_incompleta" model="pv.tipo.rechazo">
            <field name="name">Información Incompleta o Incorrecta</field>
            <field name="aplica_a">reclamo</field>
            <field name="color">1</field>
            <field name="sequence">10</field>
            <field name="descripcion">La descripción o los datos cargados no permiten evaluar el reclamo.</field>
        </record>
        <record id="rechazo_reclamo_multimedia" model="pv.tipo.rechazo">
            <field name="name">Fotos / Videos Insuficientes</field>
            <field name="aplica_a">reclamo</field>
            <field name="color">2</field>
            <field name="sequence">20</field>
            <field name="descripcion">El material adjunto no muestra la problemática con claridad.</field>
        </record>
        <record id="rechazo_reclamo_clasificacion" model="pv.tipo.rechazo">
            <field name="name">Clasificación Incorrecta</field>
            <field name="aplica_a">reclamo</field>
            <field name="color">3</field>
            <field name="sequence">30</field>
            <field name="descripcion">Sistema, subsistema, problema o tipo de desvío mal seleccionado.</field>
        </record>
        <record id="rechazo_reclamo_duplicado" model="pv.tipo.rechazo">
            <field name="name">Reclamo Duplicado</field>
            <field name="aplica_a">reclamo</field>
            <field name="color">4</field>
            <field name="sequence">40</field>
            <field name="descripcion">Ya existe un ticket para la misma falla en esta máquina.</field>
        </record>
        <record id="rechazo_reclamo_otro" model="pv.tipo.rechazo">
            <field name="name">Otro Motivo de Carga</field>
            <field name="aplica_a">reclamo</field>
            <field name="color">7</field>
            <field name="sequence">50</field>
            <field name="descripcion">Otro error de carga, detallado en el correo de notificación.</field>
        </record>

        <!-- Sin cobertura de garantía: el reclamo era válido pero la pieza la abona el concesionario/cliente -->
        <record id="rechazo_fuera_termino" model="pv.tipo.rechazo">
            <field name="name">Fuera de Término / Plazo Vencido</field>
            <field name="aplica_a">garantia</field>
            <field name="color">1</field>
            <field name="sequence">10</field>
            <field name="descripcion">El reclamo fue presentado fuera del período de vigencia o plazo contractual de garantía.</field>
        </record>
        <record id="rechazo_mal_uso" model="pv.tipo.rechazo">
            <field name="name">Daño por Mal Uso / Falla Operativa</field>
            <field name="aplica_a">garantia</field>
            <field name="color">2</field>
            <field name="sequence">20</field>
            <field name="descripcion">Desperfecto ocasionado por uso indebido, sobrecarga o negligencia en la operación de la maquinaria.</field>
        </record>
        <record id="rechazo_mantenimiento" model="pv.tipo.rechazo">
            <field name="name">Mantenimiento Inadecuado o Nulo</field>
            <field name="aplica_a">garantia</field>
            <field name="color">3</field>
            <field name="sequence">30</field>
            <field name="descripcion">Falta de engrase, lubricación, ajuste o revisiones periódicas según el manual de usuario.</field>
        </record>
        <record id="rechazo_pieza_no_original" model="pv.tipo.rechazo">
            <field name="name">Modificación o Repuesto No Original</field>
            <field name="aplica_a">garantia</field>
            <field name="color">4</field>
            <field name="sequence">40</field>
            <field name="descripcion">Se detectaron reformas no autorizadas o componentes no genuinos Crucianelli.</field>
        </record>
        <record id="rechazo_otro" model="pv.tipo.rechazo">
            <field name="name">Otro Motivo</field>
            <field name="aplica_a">garantia</field>
            <field name="color">7</field>
            <field name="sequence">50</field>
            <field name="descripcion">Causas no tipificadas, especificadas en las observaciones del cierre.</field>
        </record>
    </data>
</odoo>
