<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="config_parameter_chunk_size_kb" model="ir.config_parameter">
            <field name="key">posventa.chunk_size_kb</field>
            <field name="value">768</field>
        </record>
        <record id="config_parameter_max_file_size_mb" model="ir.config_parameter">
            <field name="key">posventa.max_file_size_mb</field>
            <field name="value">1024</field>
        </record>
    </data>

    <!-- Purga de parámetros obsoletos en bases existentes: asistente IA (deprecado) y remoto de rclone por consola -->
    <delete model="ir.config_parameter" search="[('key', 'in', ['posventa.gemini_api_key', 'posventa.gemini_model', 'posventa.enable_ai_integration', 'posventa.rclone_remote', 'posventa.rclone_drive_folder'])]"/>
</odoo>
