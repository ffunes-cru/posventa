<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_pv_check_vencimientos" model="ir.cron">
            <field name="name">Posventa: Verificar vencimientos de medidas</field>
            <field name="model_id" ref="model_pv_ticket_medida"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_vencimientos()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_pv_check_vencimientos_certificates" model="ir.cron">
            <field name="name">Posventa: Archivar vencimientos de certificados</field>
            <field name="model_id" ref="model_pv_certificado"/>
            <field name="state">code</field>
            <field name="code">model._archive_expired_certificates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_pv_notify_upcoming_expiration_certificates" model="ir.cron">
            <field name="name">Posventa: Notificar vencimientos próximos de certificados</field>
            <field name="model_id" ref="model_pv_certificado"/>
            <field name="state">code</field>
            <field name="code">model._notify_upcoming_certificate_expiration()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
