<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.posventa</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Posventa" string="Posventa" name="posventa" groups="posventa.group_pv_admin">
                    <block title="Vencimiento y Vigencia de Certificados" id="pv_certificados_setting_block">
                        <setting id="pv_fru_days" string="Plazo Nominal de Carga FRU" help="Días desde el ingreso/liberación de la máquina para que venza el plazo de carga del FRU">
                            <field name="pv_fru_expiration_days"/>
                            <span> días</span>
                        </setting>
                        <setting id="pv_fru_grace" string="Días de Gracia / Vigencia FRU" help="Días de tolerancia tras el vencimiento nominal para cargar reclamos antes de pasar a Vencido">
                            <field name="pv_fru_grace_days"/>
                            <span> días</span>
                        </setting>
                        <setting id="pv_feu_days" string="Plazo Nominal de Carga FEU" help="Días desde el ingreso/liberación de la máquina para que venza el plazo de carga del FEU">
                            <field name="pv_feu_expiration_days"/>
                            <span> días</span>
                        </setting>
                        <setting id="pv_feu_claims_validity" string="Validez de Reclamos FEU" help="Días desde la emisión/carga del FEU durante los cuales está vigente para crear tickets y renovar">
                            <field name="pv_feu_claims_validity_days"/>
                            <span> días</span>
                        </setting>
                    </block>
                    <block title="Almacenamiento de Videos y Archivos Pesados" id="pv_multimedia_setting_block">
                        <setting id="pv_storage_mode_setting" string="Dónde se guardan" help="Google Drive para uso normal; Odoo como contingencia (tope 200 MB por archivo). Cambiarlo no mueve lo ya guardado.">
                            <field name="pv_storage_mode" widget="radio"/>
                        </setting>
                        <setting id="pv_drive_credenciales_setting" string="Cuenta de servicio de Google" help="Pegue el contenido del archivo .json de la clave de la cuenta de servicio.">
                            <field name="pv_drive_credenciales" password="True" placeholder='{"type": "service_account", ...}'/>
                            <div class="text-muted mt-1" invisible="not pv_drive_cuenta">
                                Invite a <strong><field name="pv_drive_cuenta" class="d-inline"/></strong> a la unidad compartida como <em>Administrador de contenido</em>.
                            </div>
                        </setting>
                        <setting id="pv_drive_unidad_setting" string="Unidad compartida" help="ID de la unidad: lo que sigue a /drive/folders/ en la URL al abrirla en el navegador.">
                            <field name="pv_drive_unidad_id" placeholder="0ABcD..."/>
                        </setting>
                        <setting id="pv_drive_carpeta_setting" string="Carpeta en la unidad" help="Adentro se crea una carpeta por reclamo (OF_número de ticket).">
                            <field name="pv_drive_carpeta"/>
                            <div class="mt-2">
                                <button name="action_pv_probar_drive" type="object" string="Probar conexión" icon="fa-plug" class="btn-link px-0"/>
                            </div>
                            <div class="text-warning mt-1" invisible="not pv_drive_en_espera">
                                <i class="fa fa-clock-o me-1"/><field name="pv_drive_en_espera" class="d-inline"/> archivo(s) esperando subida a Drive. Se suben solos cuando la conexión funcione.
                            </div>
                        </setting>
                        <setting id="pv_chunk_size_setting" string="Tamaño de Fragmento (Chunk Size)" help="Tamaño de cada bloque al subir archivos pesados por fragmentos (768 KB recomendado para Nginx con límite 1MB)">
                            <field name="pv_multimedia_chunk_size_kb"/>
                            <span> KB</span>
                        </setting>
                        <setting id="pv_max_file_size_setting" string="Límite Máximo de Archivo" help="Tamaño máximo permitido para la subida de videos y archivos multimedia pesados (por defecto 1024 MB = 1 GB)">
                            <field name="pv_multimedia_max_size_mb"/>
                            <span> MB</span>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_pv_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes Posventa</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'posventa'}</field>
    </record>
</odoo>
