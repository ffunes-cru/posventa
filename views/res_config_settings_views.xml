<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.posventa</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Posventa" string="Posventa" name="posventa" groups="posventa.group_pv_admin">
                    <block title="Inteligencia Artificial" id="pv_ai_setting_block">
                        <setting id="pv_enable_ai" string="Asistente de IA (Gemini)" help="Habilita la integración de IA en el módulo de posventa para asistirte en los tickets">
                            <field name="pv_enable_ai_integration"/>
                        </setting>
                    </block>
                    <block title="Vencimiento y Vigencia de Certificados" id="pv_certificados_setting_block">
                        <setting id="pv_fru_days" string="Plazo Nominal de Carga FRU" help="Días desde el ingreso/liberación de la máquina para que venza el plazo de carga del FRU">
                            <field name="pv_fru_expiration_days"/>
                            <span> días</span>
                        </setting>
                        <setting id="pv_fru_grace" string="Días de Gracia / Vigencia FRU" help="Días de tolerancia tras el vencimiento nominal para cargar reclamos antes de pasar a Vencido">
                            <field name="pv_fru_grace_days"/>
                            <span> días</span>
                        </setting>
                        <setting id="pv_feu_days" string="Plazo Nominal de Carga FEU" help="Días desde el ingreso/liberación de la máquina para que venza el plazo de carga del FEU">
                            <field name="pv_feu_expiration_days"/>
                            <span> días</span>
                        </setting>
                        <setting id="pv_feu_claims_validity" string="Validez de Reclamos FEU" help="Días desde la emisión/carga del FEU durante los cuales está vigente para crear tickets y renovar">
                            <field name="pv_feu_claims_validity_days"/>
                            <span> días</span>
                        </setting>
                    </block>
                    <block title="Almacenamiento Multimedia y Google Drive (rclone)" id="pv_multimedia_setting_block">
                        <setting id="pv_rclone_remote_setting" string="Remoto de rclone" help="Nombre del remoto de Google Drive configurado en rclone en el servidor">
                            <field name="pv_rclone_remote"/>
                        </setting>
                        <setting id="pv_rclone_drive_folder_setting" string="Carpeta Base en Google Drive" help="Ruta de la carpeta donde se guardarán los archivos multimedia de los tickets">
                            <field name="pv_rclone_drive_folder"/>
                        </setting>
                        <setting id="pv_chunk_size_setting" string="Tamaño de Fragmento (Chunk Size)" help="Tamaño de cada bloque al subir archivos pesados por fragmentos (768 KB recomendado para Nginx con límite 1MB)">
                            <field name="pv_multimedia_chunk_size_kb"/>
                            <span> KB</span>
                        </setting>
                        <setting id="pv_max_file_size_setting" string="Límite Máximo de Archivo" help="Tamaño máximo permitido para la subida de videos y archivos multimedia pesados (por defecto 1024 MB = 1 GB)">
                            <field name="pv_multimedia_max_size_mb"/>
                            <span> MB</span>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_pv_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes Posventa</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'posventa'}</field>
    </record>
</odoo>
