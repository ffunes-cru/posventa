<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="pv_certificado_view_tree" model="ir.ui.view">
        <field name="name">pv.certificado.view.tree</field>
        <field name="model">pv.certificado</field>
        <field name="arch" type="xml">
            <list string="Certificados" create="1">
                <field name="name"/>
                <field name="tipo"/>
                <field name="maquina_id"/>
                <field name="fecha"/>
                <field name="concesionario_id"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="pv_certificado_view_form" model="ir.ui.view">
        <field name="name">pv.certificado.view.form</field>
        <field name="model">pv.certificado</field>
        <field name="arch" type="xml">
            <form string="Certificado">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-ticket">
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="tipo" readonly="id"/>
                            <field name="maquina_id" domain="[('tiene_cpm', '=', False)]" readonly="context.get('default_maquina_id') or id"/>
                            <field name="fecha" readonly="id"/>
                        </group>
                        <group>
                            <field name="archivo" filename="archivo_nombre" readonly="id"/>
                            <field name="archivo_nombre" invisible="1"/>
                            <field name="concesionario_id" readonly="1" force_save="1"/>
                            <field name="fecha_vencimiento" readonly="1"/>
                            <field name="active" readonly="1"/>
                        </group>
                    </group>
 
                    <notebook>
                        <page string="Tickets / Reclamos" name="tickets">
                            <field name="ticket_ids" mode="list" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="tipo_ticket"/>
                                    <field name="fecha_creacion"/>
                                    <field name="sistema_id"/>
                                    <field name="estado" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones" name="observaciones">
                            <field name="notas" placeholder="Ingrese comentarios adicionales sobre este certificado..." readonly="id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="pv_certificado_view_search" model="ir.ui.view">
        <field name="name">pv.certificado.view.search</field>
        <field name="model">pv.certificado</field>
        <field name="arch" type="xml">
            <search>
                <field name="maquina_id"/>
                <field name="tipo"/>
                <field name="concesionario_id"/>
                <filter string="FRU" name="type_fru" domain="[('tipo', '=', 'fru')]"/>
                <filter string="CPM" name="type_cpm" domain="[('tipo', '=', 'cpm')]"/>
                <filter string="FEU" name="type_feu" domain="[('tipo', '=', 'feu')]"/>
                <filter string="Recall" name="type_recall" domain="[('tipo', '=', 'recall')]"/>
                <filter string="Máquina" name="group_maquina" context="{'group_by': 'maquina_id'}"/>
                <filter string="Tipo" name="group_tipo" context="{'group_by': 'tipo'}"/>
                <filter string="Concesionario" name="group_concesionario" context="{'group_by': 'concesionario_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pv_certificado" model="ir.actions.act_window">
        <field name="name">Certificados</field>
        <field name="res_model">pv.certificado</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pv_certificado_view_search"/>
    </record>
</odoo>
