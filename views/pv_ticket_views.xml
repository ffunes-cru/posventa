<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="pv_ticket_view_tree" model="ir.ui.view">
        <field name="name">pv.ticket.view.tree</field>
        <field name="model">pv.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets de Reclamo">
                <field name="name" decoration-bf="1"/>
                <field name="maquina_id"/>
                <field name="cliente_id" optional="show"/>
                <field name="tipo_garantia" optional="hide"/>
                <field name="estado" widget="badge" decoration-info="estado == 'abierto'" decoration-warning="estado == 'en_proceso'" decoration-success="estado == 'aceptado'" decoration-danger="estado == 'rechazado'" decoration-muted="estado == 'cerrado'"/>
                <field name="fecha_creacion" optional="show"/>
                <field name="of" optional="show"/>
                <field name="tipo_ticket" optional="hide"/>
                <field name="certificado_id" optional="hide"/>
                <field name="concesionario_id" optional="hide"/>
                <field name="sistema_id" optional="hide"/>
                <field name="subsistema_id" optional="hide"/>
                <field name="responsable_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="t1_horas" string="T1 (h)" optional="hide"/>
                <field name="t2_horas" string="T2 (h)" optional="hide"/>
                <field name="t3_horas" string="T3 (h)" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View (Mobile friendly, like sales orders) -->
    <record id="pv_ticket_view_kanban" model="ir.ui.view">
        <field name="name">pv.ticket.view.kanban</field>
        <field name="model">pv.ticket</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" quick_create="false" records_draggable="false">
                <field name="name"/>
                <field name="maquina_id"/>
                <field name="cliente_id"/>
                <field name="of"/>
                <field name="tipo_ticket"/>
                <field name="tipo_garantia"/>
                <field name="responsable_id"/>
                <field name="estado"/>
                <field name="fecha_creacion"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline mb-1">
                            <field name="maquina_id" class="fw-bolder fs-5 me-2"/>
                            <field name="estado" widget="label_selection" options="{'classes': {'borrador': 'secondary', 'abierto': 'info', 'en_proceso': 'warning', 'aceptado': 'success', 'rechazado': 'danger', 'cerrado': 'dark'}}" class="ms-auto flex-shrink-0"/>
                        </div>
                        <div class="d-flex align-items-center text-muted mb-2 small" t-if="record.cliente_id.raw_value">
                            <i class="fa fa-user me-1 text-secondary"/> <field name="cliente_id" class="fw-semibold text-dark"/>
                        </div>
                        <footer class="align-items-end">
                            <div class="d-flex flex-wrap gap-1 text-muted text-nowrap align-items-center">
                                <field name="name" class="fw-bold"/>
                                <span t-if="record.of.raw_value">• OF: <field name="of"/></span>
                                <span t-if="record.tipo_ticket.raw_value">• <field name="tipo_ticket"/></span>
                                <span t-if="record.fecha_creacion.raw_value">• <field name="fecha_creacion"/></span>
                            </div>
                            <field name="responsable_id" widget="many2one_avatar_user" class="ms-auto" t-if="record.responsable_id.raw_value"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
<record id="pv_ticket_view_form" model="ir.ui.view">
        <field name="name">pv.ticket.view.form</field>
        <field name="model">pv.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket de Reclamo">
                <header>
                    <button name="action_enviar_ticket" string="Enviar Ticket" type="object" class="oe_highlight" invisible="estado != 'borrador'"/>
                    <button name="action_tomar_ticket" string="Tomar Ticket" type="object" class="oe_highlight" invisible="estado != 'abierto'" groups="posventa.group_pv_staff"/>
                    <button name="action_aceptar_ticket" string="Aceptar Reclamo" type="object" class="oe_highlight" invisible="estado != 'en_proceso'" groups="posventa.group_pv_staff"/>
                    <button name="action_rechazar_ticket" string="Rechazar Reclamo" type="object" class="btn-danger" invisible="estado != 'en_proceso'" groups="posventa.group_pv_staff"/>
                    <button name="action_cerrar_ticket" string="Cerrar Ticket" type="object" class="oe_highlight" invisible="estado != 'aceptado'" groups="posventa.group_pv_staff"/>
                    
                    <button name="action_back_to_borrador" string="Volver a Borrador" type="object" class="btn-secondary" invisible="estado != 'abierto'" groups="posventa.group_pv_admin"/>
                    <button name="action_back_to_abierto" string="Volver a Abierto" type="object" class="btn-secondary" invisible="estado != 'en_proceso'" groups="posventa.group_pv_staff"/>
                    <button name="action_back_to_en_proceso" string="Volver a En Proceso" type="object" class="btn-secondary" invisible="estado not in ('aceptado', 'rechazado')" groups="posventa.group_pv_staff"/>
                    <button name="action_back_to_aceptado" string="Volver a Aceptado" type="object" class="btn-secondary" invisible="estado != 'cerrado'" groups="posventa.group_pv_admin"/>
                    
                    <field name="estado" widget="statusbar" statusbar_visible="abierto,en_proceso,aceptado,cerrado"/>
                </header>
                <sheet>
                    <field name="storage_mode" invisible="1"/>
                    <div class="alert alert-warning border-start border-4 border-warning shadow-sm rounded-3 mb-3 p-2" role="alert" invisible="estado != 'borrador'">
                        <i class="fa fa-info-circle me-1"/> <strong>Requisito para envío:</strong> Es obligatorio adjuntar al menos una imagen o video donde se observe la problemática antes de enviar el ticket a revisión técnica.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_abrir_carpeta_drive" type="object" class="oe_stat_button" icon="fa-video-camera" invisible="multimedia_count == 0 and not drive_folder_url and not multimedia_url">
                            <field name="multimedia_count" widget="statinfo" string="Videos Drive"/>
                        </button>
                        <button name="action_view_medidas" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="medida_count" widget="statinfo" string="Medidas"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos de Máquina">
                            <field name="maquina_id" readonly="estado != 'borrador'" domain="[('estado', 'not in', ('liberada', 'pendiente', 'cpm_vencido'))]"/>
                            <field name="tipo_ticket" readonly="1" force_save="1"/>
                            <field name="certificado_id" readonly="1"/>
                            <field name="cliente_id" readonly="1"/>
                            <field name="concesionario_id" readonly="1"/>
                        </group>
                        <group string="Operador e Información General">
                            <field name="operador_id" readonly="estado != 'borrador'"/>
                            <field name="responsable_id" readonly="1" groups="!posventa.group_pv_staff"/>
                            <field name="responsable_id" readonly="estado in ('borrador', 'abierto')" groups="posventa.group_pv_staff"/>
                            <field name="tipo_garantia" widget="badge" invisible="estado not in ('aceptado', 'cerrado')"/>
                            <field name="multimedia_url" widget="url" placeholder="https://drive.google.com/drive/folders/..."/>
                        </group>
                    </group>
                    
                    <group string="Clasificación Post-PM" invisible="tipo_ticket == 'pre_pm'">
                        <group>
                            <field name="sistema_id" required="tipo_ticket == 'post_pm'" readonly="estado != 'borrador'"/>
                            <field name="subsistema_id" required="tipo_ticket == 'post_pm'" readonly="estado != 'borrador'"/>
                            <field name="problema_id" readonly="estado != 'borrador'"/>
                        </group>
                        <group>
                            <field name="ubicacion_actual"/>
                            <field name="hectareas"/>
                        </group>
                    </group>
                    
                    <group string="Clasificación Pre-PM" invisible="tipo_ticket == 'post_pm'">
                        <group>
                            <field name="desvio_tipo_id" required="tipo_ticket == 'pre_pm'" readonly="estado != 'borrador'" options="{'no_create_edit': False}"/>
                            <field name="desvio_tipo" invisible="1"/>
                        </group>
                    </group>
                    <group string="Información Dinámica del Subsistema" invisible="not campo_extra_ids or tipo_ticket == 'pre_pm'">
                        <field name="campo_extra_ids" nolabel="1" readonly="estado != 'borrador'">
                            <list editable="bottom" create="false" delete="false">
                                <field name="campo_id" readonly="1" force_save="1"/>
                                <field name="campo_nombre" readonly="1"/>
                                <field name="valor"/>
                            </list>
                        </field>
                    </group>
                    <group string="Detalles del Reclamo">
                        <field name="placeholder_descripcion" invisible="not subsistema_id or not placeholder_descripcion"/>
                        <field name="descripcion" required="1" readonly="estado != 'borrador'" placeholder="Describa brevemente el problema..."/>
                        <field name="acciones_realizadas" readonly="estado != 'borrador'" placeholder="Indique qué acciones..."/>
                        <field name="rechazo_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': False}" invisible="estado not in ('en_proceso', 'rechazado')" readonly="estado != 'en_proceso'"/>
                        <field name="motivo_rechazo" invisible="estado not in ('en_proceso', 'rechazado')" readonly="1" groups="!posventa.group_pv_staff"/>
                        <field name="motivo_rechazo" invisible="estado not in ('en_proceso', 'rechazado')" readonly="estado != 'en_proceso'" groups="posventa.group_pv_staff"/>
                    </group>
                    <notebook>
                        <page string="Análisis de Garantía" name="garantia" invisible="estado not in ('aceptado', 'cerrado')">
                            <group>
                                <field name="tipo_garantia" readonly="1"/>
                                <field name="garantia_aceptada" readonly="1"/>
                                <field name="rechazo_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1" invisible="garantia_aceptada"/>
                                <field name="garantia_observaciones" readonly="1"/>
                                <field name="garantia_adjunto" filename="garantia_adjunto_name" readonly="1"/>
                                <field name="garantia_adjunto_name" invisible="1"/>
                            </group>
                        </page>
                        <page string="Datos SAP (IT / PV)" name="sap" groups="posventa.group_pv_staff">
                            <group>
                                <group>
                                    <field name="sap_numero_aviso" readonly="estado not in ('aceptado', 'en_proceso')"/>
                                    <field name="sap_numero_orden" readonly="estado not in ('aceptado', 'en_proceso')"/>
                                    <field name="sap_numero_pedido" readonly="estado not in ('aceptado', 'en_proceso')"/>
                                </group>
                                <group>
                                    <field name="sap_centro" readonly="estado not in ('aceptado', 'en_proceso')"/>
                                    <field name="sap_material" readonly="estado not in ('aceptado', 'en_proceso')"/>
                                </group>
                            </group>
                            <field name="sap_notas" placeholder="Notas internas para SAP..."/>
                        </page>
                        
                        <page string="Tiempos y KPIs" name="kpis">
                            <group>
                                <group string="Fechas Clave">
                                    <field name="fecha_creacion"/>
                                    <field name="fecha_primera_atencion"/>
                                    <field name="fecha_solucion"/>
                                    <field name="fecha_cierre"/>
                                </group>
                                <group string="Indicadores (Horas)">
                                    <field name="t1_horas" string="T1 - Primera Atención"/>
                                    <field name="t2_horas" string="T2 - Solución"/>
                                    <field name="t3_horas" string="T3 - Solución Definitiva (Interno)" groups="posventa.group_pv_staff"/>
                                </group>
                            </group>
                        </page>

                        <page string="Medidas y Seguimiento" name="medidas">
                            <field name="medida_ids" mode="list">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="tipo"/>
                                    <field name="responsable_id"/>
                                    <field name="fecha_vencimiento"/>
                                    <field name="estado" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <page string="Multimedia y Videos (Drive)" name="multimedia">
                            <div class="alert alert-info py-2 mb-3" role="status" invisible="storage_mode != 'odoo'">
                                <i class="fa fa-info-circle me-1"/> El modo de almacenamiento seleccionado en los ajustes es <strong>Estándar de Odoo</strong>. Puede arrastrar y adjuntar archivos directamente en el Chatter. Los archivos previamente guardados en Drive se conservan disponibles.
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h5 class="mb-1 text-primary"><i class="fa fa-cloud-upload me-2"/> Archivos Multimedia Pesados (Hasta 1 GB)</h5>
                                    <p class="text-muted small mb-0">Videos de diagnóstico en campo y adjuntos de gran tamaño almacenados en Google Drive.</p>
                                </div>
                                <div class="d-flex gap-2">
                                    <button name="action_adjuntar_multimedia" type="object" string="Adjuntar Video / Multimedia" class="btn btn-primary" icon="fa-cloud-upload" invisible="storage_mode != 'drive'"/>
                                    <button name="action_abrir_carpeta_drive" type="object" string="Abrir Carpeta en Google Drive" class="btn btn-outline-primary" icon="fa-folder-open" invisible="multimedia_count == 0 and not drive_folder_url and not multimedia_url"/>
                                </div>
                            </div>
                            <field name="multimedia_ids" mode="list" readonly="1">
                                <list decoration-muted="estado_sync == 'subiendo'" decoration-info="estado_sync == 'procesando'" decoration-success="estado_sync == 'disponible'" decoration-danger="estado_sync == 'error'" delete="true">
                                    <field name="is_video" column_invisible="True"/>
                                    <field name="name" string="Archivo"/>
                                    <field name="file_size_display" string="Tamaño"/>
                                    <field name="mimetype" string="Formato"/>
                                    <field name="fecha_subida" string="Fecha Carga"/>
                                    <field name="usuario_id" string="Cargado por"/>
                                    <field name="estado_sync" widget="badge" 
                                        decoration-info="estado_sync == 'procesando'" 
                                        decoration-success="estado_sync == 'disponible'" 
                                        decoration-danger="estado_sync == 'error'" 
                                        decoration-warning="estado_sync == 'subiendo'"/>
                                    <field name="error_message" string="Detalle Error" optional="show" invisible="estado_sync != 'error'"/>
                                    <button name="action_abrir_drive" type="object" string="Ver en Drive" class="btn-sm btn-primary" icon="fa-external-link" invisible="not drive_url"/>
                                    <button name="action_reintentar_sync" type="object" string="Reintentar Sync" class="btn-sm btn-outline-danger" icon="fa-refresh" invisible="estado_sync != 'error'"/>
                                </list>
                            </field>
                        </page>
                    </notebook> 
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="pv_ticket_view_search" model="ir.ui.view">
        <field name="name">pv.ticket.view.search</field>
        <field name="model">pv.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="maquina_id"/>
                <field name="cliente_id"/>
                <field name="certificado_id"/>
                <field name="concesionario_id"/>
                <field name="sistema_id"/>
                <field name="subsistema_id"/>
                <field name="responsable_id"/>
                <filter string="Abiertos" name="state_abierto" domain="[('estado', '=', 'abierto')]"/>
                <filter string="En Proceso" name="state_en_proceso" domain="[('estado', '=', 'en_proceso')]"/>
                <filter string="Aceptados" name="state_aceptado" domain="[('estado', '=', 'aceptado')]"/>
                <filter string="Cerrados" name="state_cerrado" domain="[('estado', '=', 'cerrado')]"/>
                <separator/>
                <filter string="Garantía Técnica" name="garantia_tecnica" domain="[('tipo_garantia', '=', 'tecnica')]"/>
                <filter string="Garantía Comercial" name="garantia_comercial" domain="[('tipo_garantia', '=', 'comercial')]"/>
                <filter string="Medidas Vencidas" name="medidas_vencidas" domain="[('medidas_vencidas_count', '>', 0)]"/>
                <separator/>
                <filter string="Cliente" name="group_cliente" context="{'group_by': 'cliente_id'}"/>
                <filter string="Concesionario" name="group_concesionario" context="{'group_by': 'concesionario_id'}"/>
                <filter string="Certificado" name="group_certificado" context="{'group_by': 'certificado_id'}"/>
                <filter string="Sistema" name="group_sistema" context="{'group_by': 'sistema_id'}"/>
                <filter string="Estado" name="group_estado" context="{'group_by': 'estado'}"/>
                <filter string="Responsable" name="group_responsable" context="{'group_by': 'responsable_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pv_ticket" model="ir.actions.act_window">
        <field name="name">Tickets de Reclamo</field>
        <field name="res_model">pv.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="pv_ticket_view_search"/>
    </record>

    <!-- Dedicated Form View for Multimedia (Modal Popup without Chatter) -->
    <record id="pv_ticket_multimedia_view_form" model="ir.ui.view">
        <field name="name">pv.ticket.multimedia.view.form</field>
        <field name="model">pv.ticket.multimedia</field>
        <field name="arch" type="xml">
            <form string="Archivo Multimedia">
                <header>
                    <button name="action_abrir_drive" type="object" string="Abrir en Google Drive" class="btn-primary" icon="fa-external-link" invisible="not drive_url"/>
                    <button name="action_reintentar_sync" type="object" string="Reintentar Sincronización" class="btn-secondary" icon="fa-refresh" invisible="estado_sync == 'disponible'"/>
                    <field name="estado_sync" widget="statusbar" statusbar_visible="subiendo,procesando,disponible"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nombre de Archivo"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-danger py-2 mt-2" role="alert" invisible="estado_sync != 'error'">
                        <strong><i class="fa fa-exclamation-triangle me-1"/> Error en transferencia a Google Drive:</strong>
                        <field name="error_message" class="d-block mt-1 font-monospace text-muted small" readonly="1"/>
                    </div>
                    <div class="alert alert-info py-2 mt-2" role="alert" invisible="estado_sync != 'procesando'">
                        <i class="fa fa-spinner fa-spin me-1"/> El archivo está siendo transferido a Google Drive por rclone en segundo plano.
                    </div>
                    <group>
                        <group string="Detalles Técnicos">
                            <field name="ticket_id" readonly="1"/>
                            <field name="file_size_display" string="Tamaño"/>
                            <field name="mimetype" readonly="1"/>
                            <field name="is_video" readonly="1"/>
                        </group>
                        <group string="Ubicación y Almacenamiento">
                            <field name="drive_url" widget="url" readonly="1" invisible="not drive_url"/>
                            <field name="drive_folder_url" widget="url" readonly="1" invisible="not drive_folder_url"/>
                            <field name="fecha_subida" readonly="1"/>
                            <field name="usuario_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>


