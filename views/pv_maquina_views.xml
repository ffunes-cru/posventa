<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="pv_maquina_view_tree" model="ir.ui.view">
        <field name="name">pv.maquina.view.tree</field>
        <field name="model">pv.maquina</field>
        <field name="arch" type="xml">
            <list string="Máquinas" create="1">
                <field name="of"/>
                <field name="tipo"/>
                <field name="concesionario_id"/>
                <field name="cliente_id"/>
                <field name="ciudad"/>
                <field name="provincia_id"/>
                <field name="estado" widget="badge" decoration-success="estado == 'vendida'" decoration-warning="estado == 'stock'" decoration-info="estado == 'liberada'"/>
                <field name="tiene_fru" string="FRU" widget="boolean"/>
                <field name="tiene_cpm" string="CPM" widget="boolean"/>
                <field name="tiene_feu" string="FEU" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="pv_maquina_view_form" model="ir.ui.view">
        <field name="name">pv.maquina.view.form</field>
        <field name="model">pv.maquina</field>
        <field name="arch" type="xml">
            <form string="Máquina Posventa">
                <header>
                    <button name="action_abrir_wizard_transferencia" string="Trasladar Máquina" type="object" class="btn-secondary" invisible="estado != 'stock' or liberacion_solicitada" groups="posventa.group_pv_admin"/>
                    <button name="action_aceptar_transferencia" string="Aceptar Transferencia" type="object" class="oe_highlight" invisible="estado != 'pendiente' or not (es_concesionario_destino or is_pv_admin)"/>
                    <button name="action_rechazar_transferencia" string="Rechazar Transferencia" type="object" class="btn-secondary" invisible="estado != 'pendiente' or not (es_concesionario_destino or is_pv_admin)"/>
                    <button name="action_cancelar_transferencia" string="Cancelar Traslado" type="object" class="btn-secondary" invisible="estado != 'pendiente'" groups="posventa.group_pv_admin"/>

                    <button name="action_aprobar_liberacion" string="Aprobar Liberación" type="object" class="oe_highlight" invisible="not liberacion_solicitada" groups="posventa.group_pv_admin" confirm="La máquina vuelve a LIBERADA y se archivan sus certificados. ¿Continuar?"/>
                    <button name="action_rechazar_liberacion" string="Rechazar Liberación" type="object" class="btn-secondary" invisible="not liberacion_solicitada" groups="posventa.group_pv_admin"/>
                    <button name="action_abrir_wizard_liberacion" string="Liberar Máquina (Canje)" type="object" class="btn-secondary" invisible="liberacion_solicitada or estado not in ('stock', 'vendida', 'cpm_vencido')" groups="posventa.group_pv_admin"/>

                    <field name="estado" widget="statusbar" statusbar_visible="liberada,stock,vendida,cpm_vencido"/>
                </header>
                <sheet>
                    <field name="es_concesionario_destino" invisible="1"/>
                    <field name="is_pv_admin" invisible="1"/>
                    <div class="alert alert-warning mb-3" role="alert" invisible="not liberacion_solicitada">
                        <strong>Liberación solicitada</strong> por <field name="liberacion_solicitante_id" class="d-inline" readonly="1"/>
                        el <field name="liberacion_fecha_solicitud" class="d-inline" readonly="1"/>.
                        Motivo: <field name="liberacion_motivo" class="d-inline" readonly="1"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_certificados" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="certificado_count" widget="statinfo" string="Certificados"/>
                        </button>
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-ticket" invisible="estado in ('liberada', 'pendiente')">
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos de Fábrica">
                            <field name="of" readonly="not is_pv_admin"/>
                            <field name="tipo" readonly="not is_pv_admin"/>
                        </group>
                        <group string="Asignación y Ubicación">
                            <field name="concesionario_id" readonly="not is_pv_admin"/>
                            <field name="cliente_id" readonly="not is_pv_admin"/>
                            <field name="ciudad" readonly="not is_pv_admin"/>
                            <field name="provincia_id" readonly="not is_pv_admin"/>
                            <field name="fecha_venta" invisible="estado != 'vendida'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Certificados" name="certificados">
                            <field name="certificado_ids" mode="list" readonly="1">
                                <list>
                                    <field name="tipo"/>
                                    <field name="concesionario_id" string="Concesionario Emisor"/>
                                    <field name="estado_certificado" widget="badge" decoration-success="estado_certificado == 'vigente'" decoration-danger="estado_certificado == 'vencido'" decoration-warning="estado_certificado == 'archivado_traslado'"/>
                                    <field name="fecha"/>
                                    <field name="fecha_vencimiento"/>
                                    <field name="dias_para_vencer"/>
                                    <field name="archivo_nombre"/>
                                </list>
                            </field>
                        </page>
                        <page string="Historial de Tickets" name="tickets">
                            <field name="ticket_ids" mode="list" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="tipo_ticket"/>
                                    <field name="fecha_creacion"/>
                                    <field name="sistema_id"/>
                                    <field name="estado" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="pv_maquina_view_search" model="ir.ui.view">
        <field name="name">pv.maquina.view.search</field>
        <field name="model">pv.maquina</field>
        <field name="arch" type="xml">
            <search>
                <field name="of"/>
                <field name="tipo"/>
                <field name="concesionario_id"/>
                <field name="cliente_id"/>
                <filter string="Liberada" name="state_liberada" domain="[('estado', '=', 'liberada')]"/>
                <filter string="En Stock" name="state_stock" domain="[('estado', '=', 'stock')]"/>
                <filter string="Vendida" name="state_vendida" domain="[('estado', '=', 'vendida')]"/>
                <separator/>
                <filter string="Sin CPM" name="no_cpm" domain="[('tiene_cpm', '=', False)]"/>
                <filter string="Con CPM" name="has_cpm" domain="[('tiene_cpm', '=', True)]"/>
                <filter string="Concesionario" name="group_concesionario" context="{'group_by': 'concesionario_id'}"/>
                <filter string="Tipo de Máquina" name="group_tipo" context="{'group_by': 'tipo'}"/>
                <filter string="Estado" name="group_estado" context="{'group_by': 'estado'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_pv_maquina" model="ir.actions.act_window">
        <field name="name">Máquinas</field>
        <field name="res_model">pv.maquina</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pv_maquina_view_search"/>
    </record>

    <!-- Standalone Restricted Tree View (No inherit, won't affect admin/staff) -->
    <record id="pv_maquina_view_tree_restricted" model="ir.ui.view">
        <field name="name">pv.maquina.view.tree.restricted</field>
        <field name="model">pv.maquina</field>
        <field name="arch" type="xml">
            <list string="Máquinas" create="0" delete="0" edit="0">
                <field name="of"/>
                <field name="tipo"/>
                <field name="concesionario_id"/>
                <field name="cliente_id"/>
                <field name="ciudad"/>
                <field name="provincia_id"/>
                <field name="estado" widget="badge" decoration-success="estado == 'vendida'" decoration-warning="estado == 'stock'" decoration-info="estado == 'liberada'"/>
                <field name="tiene_fru" string="FRU" widget="boolean"/>
                <field name="tiene_cpm" string="CPM" widget="boolean"/>
                <field name="tiene_feu" string="FEU" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Restricted Window Action -->
    <record id="action_pv_maquina_restricted" model="ir.actions.act_window">
        <field name="name">Máquinas (Restringido)</field>
        <field name="res_model">pv.maquina</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="pv_maquina_view_tree_restricted"/>
        <field name="search_view_id" ref="pv_maquina_view_search"/>
    </record>

</odoo>
