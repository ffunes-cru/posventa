<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Graph and Pivot Views (Retained for Ticket analysis) -->
    <record id="pv_ticket_view_graph" model="ir.ui.view">
        <field name="name">pv.ticket.view.graph</field>
        <field name="model">pv.ticket</field>
        <field name="arch" type="xml">
            <graph string="Métricas de Tickets" type="bar" sample="1">
                <field name="sistema_id" type="row"/>
                <field name="t2_horas" type="measure" operator="avg" string="Tiempo de Solución Promedio (Horas)"/>
            </graph>
        </field>
    </record>

    <record id="pv_ticket_view_pivot" model="ir.ui.view">
        <field name="name">pv.ticket.view.pivot</field>
        <field name="model">pv.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Tickets" sample="1">
                <field name="concesionario_id" type="row"/>
                <field name="estado" type="col"/>
                <field name="t1_horas" type="measure" operator="avg"/>
                <field name="t2_horas" type="measure" operator="avg"/>
                <field name="t3_horas" type="measure" operator="avg"/>
            </pivot>
        </field>
    </record>

    <!-- Full-Width Responsive Dashboard Form View -->
    <record id="pv_dashboard_view_form" model="ir.ui.view">
        <field name="name">pv.dashboard.view.form</field>
        <field name="model">pv.dashboard</field>
        <field name="arch" type="xml">
            <form string="Tablero de Control" create="0" edit="0" delete="0" class="o_dashboard_form">
                <!-- Estilos en static/src/backend/posventa_backend.scss -->
                <sheet>
                    <div class="container-fluid p-0">
                        <div class="row align-items-center pv-dashboard-banner">
                            <div class="col-md-8 col-12 mb-3 mb-md-0">
                                <h3 class="text-primary">Tablero de Control Operativo</h3>
                                <p class="text-muted">Resumen en tiempo real del estado de los reclamos y KPIs de posventa.</p>
                            </div>
                            <div class="col-md-4 col-12 text-md-end text-start">
                                <button type="object" name="action_view_metrics" class="btn btn-primary">
                                    <i class="fa fa-bar-chart-o me-2"/> Ver Gráficos y Análisis Pivot
                                </button>
                            </div>
                        </div>

                        <!-- Tickets por estado -->
                        <div class="row">
                            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                                <div class="card pv-estado pv-estado-borrador">
                                    <div class="card-body">
                                        <h6 class="text-muted">Borrador</h6>
                                        <div class="pv-estado-cuenta text-secondary">
                                            <field name="count_borrador" readonly="1"/>
                                        </div>
                                        <button type="object" name="action_view_tickets" context="{'estado': 'borrador'}" class="btn btn-outline-secondary btn-sm">
                                            Ver Listado <i class="fa fa-chevron-right ms-1"/>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                                <div class="card pv-estado pv-estado-abierto">
                                    <div class="card-body">
                                        <h6 class="text-muted">Abiertos</h6>
                                        <div class="pv-estado-cuenta text-info">
                                            <field name="count_abierto" readonly="1"/>
                                        </div>
                                        <button type="object" name="action_view_tickets" context="{'estado': 'abierto'}" class="btn btn-outline-info btn-sm">
                                            Ver Listado <i class="fa fa-chevron-right ms-1"/>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                                <div class="card pv-estado pv-estado-en_proceso">
                                    <div class="card-body">
                                        <h6 class="text-muted">En Proceso</h6>
                                        <div class="pv-estado-cuenta text-warning">
                                            <field name="count_en_proceso" readonly="1"/>
                                        </div>
                                        <button type="object" name="action_view_tickets" context="{'estado': 'en_proceso'}" class="btn btn-outline-warning btn-sm">
                                            Ver Listado <i class="fa fa-chevron-right ms-1"/>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                                <div class="card pv-estado pv-estado-aceptado">
                                    <div class="card-body">
                                        <h6 class="text-muted">Aceptados</h6>
                                        <div class="pv-estado-cuenta text-success">
                                            <field name="count_aceptado" readonly="1"/>
                                        </div>
                                        <button type="object" name="action_view_tickets" context="{'estado': 'aceptado'}" class="btn btn-outline-success btn-sm">
                                            Ver Listado <i class="fa fa-chevron-right ms-1"/>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                                <div class="card pv-estado pv-estado-rechazado">
                                    <div class="card-body">
                                        <h6 class="text-muted">Rechazados</h6>
                                        <div class="pv-estado-cuenta text-danger">
                                            <field name="count_rechazado" readonly="1"/>
                                        </div>
                                        <button type="object" name="action_view_tickets" context="{'estado': 'rechazado'}" class="btn btn-outline-danger btn-sm">
                                            Ver Listado <i class="fa fa-chevron-right ms-1"/>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-2 col-md-4 col-sm-6 mb-4">
                                <div class="card pv-estado pv-estado-cerrado">
                                    <div class="card-body">
                                        <h6 class="text-muted">Cerrados</h6>
                                        <div class="pv-estado-cuenta text-dark">
                                            <field name="count_cerrado" readonly="1"/>
                                        </div>
                                        <button type="object" name="action_view_tickets" context="{'estado': 'cerrado'}" class="btn btn-outline-dark btn-sm">
                                            Ver Listado <i class="fa fa-chevron-right ms-1"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tiempos promedio (horas) -->
                        <div class="row mt-3">
                            <div class="col-md-4 col-12 mb-4">
                                <div class="card pv-kpi pv-kpi-t1">
                                    <h6>T1: Primera Atención</h6>
                                    <h2><field name="avg_t1" readonly="1"/>h</h2>
                                    <p>Tiempo promedio hasta primera atención.</p>
                                </div>
                            </div>

                            <div class="col-md-4 col-12 mb-4">
                                <div class="card pv-kpi pv-kpi-t2">
                                    <h6>T2: Tiempo de Solución</h6>
                                    <h2><field name="avg_t2" readonly="1"/>h</h2>
                                    <p>Tiempo promedio para resolver el reclamo.</p>
                                </div>
                            </div>

                            <div class="col-md-4 col-12 mb-4">
                                <div class="card pv-kpi pv-kpi-t3">
                                    <h6>T3: Cierre Definitivo</h6>
                                    <h2><field name="avg_t3" readonly="1"/>h</h2>
                                    <p>Tiempo promedio hasta cierre administrativo.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action that triggers action_open_dashboard server-side or opens form mode directly -->
    <record id="action_pv_dashboard" model="ir.actions.act_window">
        <field name="name">Tablero de Control</field>
        <field name="res_model">pv.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="pv_dashboard_view_form"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                El tablero está listo.
            </p>
        </field>
    </record>

    <!-- Server Action to open the dashboard transient record dynamically -->
    <record id="action_pv_dashboard_server" model="ir.actions.server">
        <field name="name">Tablero de Control</field>
        <field name="model_id" ref="model_pv_dashboard"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_open_dashboard()
        </field>
    </record>
</odoo>